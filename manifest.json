{
  "manifest_version": 2,
  "name": "TextGrab",
  "version": "1.2.1",
  "description": "Extract clean article text from any webpage and copy it to clipboard for pasting into AI tools.",
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus"
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon.svg",
      "64": "icons/icon.svg"
    }
  }
}
